# 可放在「專案根目錄」：在 backend 執行 npm run dev 時會自動讀取 ../.env（覆寫 backend/.env）

# MongoDB：僅儲存登入帳號（users），不儲存詩歌列表或 PPT 紀錄
MONGO_URI=mongodb://mongo:27017
JWT_SECRET=supersecretjwtkey_please_change_this_in_production
VITE_API_URL=http://localhost:3000

# --- 詩歌清單：一律從本機檔案讀取（Google 試算表請先同步成 xlsx）---
# 不設 SONGS_FILE_PATH 時，若存在 resources/songs_db.json 則讀 json
SONGS_DATA_SOURCE=xlsx
SONGS_FILE_PATH="Z:/Google Cloud/2025 別是巴教會詩歌/2025別是巴修正詩歌清單 .xlsx"
# 別是巴格式為橫向多組「編號、歌名」：wide（預設）；若只有 A、B 兩欄一列一首則設 simple
#SONGS_XLSX_LAYOUT=wide
#SONGS_XLSX_SHEET_INDEX=0
# 僅 SONGS_XLSX_LAYOUT=simple 時使用下列欄位索引
#SONGS_XLSX_COL_ID=0
#SONGS_XLSX_COL_NAME=1
#SONGS_XLSX_SKIP_ROWS=1

# PPT：本機資料夾（雲端同步「2025 別是巴聖教會雲端詩歌PPT」到此路徑）；不設則用 resources/ppt_library
#PPT_LIBRARY_PATH="Z:/Google Cloud/2025 別是巴教會詩歌/2025 別是巴聖教會雲端詩歌PPT"

# 歌譜根目錄（內含 401-500 等子資料夾；檔名如 401你是否曾求救主洗罪能.pdf / .jpg / .png）；不設則詩歌資料庫歌譜欄一律缺檔
#SCORE_LIBRARY_PATH="Z:/Google Cloud/2025 別是巴教會詩歌/2025 別是巴教會雲端詩歌譜"

# 設為 1 時不連 Mongo（無法登入）；詩歌仍讀檔案
#SKIP_MONGO=1

# 詩歌 PPT 檔案列表快取（毫秒）
#PPT_LIBRARY_CACHE_TTL_MS=300000

# --- Docker（http://localhost:8080）---
# 須為「本機磁碟」路徑（內含：歌單 xlsx、PPT 資料夾、歌譜資料夾）。網路磁碟機／RaiDrive 的 Z: 掛到容器內常為空目錄，請複製到專案下再設，例如：
# SONGS_CLOUD_ROOT=D:/path/to/Auto_ppt_word/resources/docker_cloud
# 容器內對應 /app/cloud；docker-compose 內固定子路徑（名稱須與實際資料夾一致）：
#   PPT:  2025 別是巴聖教會雲端詩歌PPT
#   歌譜: 2025 別是巴教會雲端詩歌譜
#   歌單: 2025別是巴修正詩歌清單.xlsx
#SONGS_CLOUD_ROOT="Z:/Google Cloud/2025 別是巴教會詩歌"

# Cloudflare Tunnel
# docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
