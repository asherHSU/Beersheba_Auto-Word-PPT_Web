MONGO_URI=mongodb://mongo:27017
JWT_SECRET=supersecretjwtkey_please_change_this_in_production
VITE_API_URL=http://localhost:3000

# 詩歌 PPT 檔案列表快取（毫秒）。雲端同步到 NAS 後，列表上的「有無檔案」會在過期後自動重掃。
# -1 = 不自動過期（僅重啟後端或上傳檔案後刷新）。預設 300000（5 分鐘）。
#PPT_LIBRARY_CACHE_TTL_MS=300000

# （選填，給 Docker / Synology）本機「詩歌 PPT」資料夾的絕對路徑，會掛載為容器內 /app/resources/ppt_library。
# 不設定時使用專案內 ./resources/ppt_library。
# 路徑含空白時請保留引號。請用 SSH 或 File Station 確認實際路徑（多為 /volume1/共用資料夾名稱/...）。
#PPT_LIBRARY_HOST_PATH="/volume1/Google Cloud/2025 別是巴教會詩歌/2025 別是巴聖教會雲端詩歌PPT"

# （選用）Cloudflare Tunnel：在 Zero Trust 建立 Tunnel 後複製的 Token。與 docker compose --profile tunnel 併用。
# 未使用 Tunnel 時可留空，避免 compose 出現「變數未設定」提示。
CLOUDFLARE_TUNNEL_TOKEN=